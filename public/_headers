/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Referrer-Policy: strict-origin-when-cross-origin
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://accounts.google.com/gsi/client; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://accounts.google.com/gsi/style; font-src https://fonts.gstatic.com; img-src 'self' data: https://eraaxis.com https://api.edos.eraaxis.com; connect-src 'self' https://api.edos.eraaxis.com https://accounts.google.com/gsi/; frame-src https://www.google.com https://accounts.google.com/gsi/

# Private links: a certificate ID and an attendance token. Netlify answers these with
# the generic index.html, so the page's own robots tag exists only once JavaScript
# runs. The header reaches every crawler, including ones that never run it.
/certificates/verify/*
  X-Robots-Tag: noindex, nofollow, noarchive

/attendance/*
  X-Robots-Tag: noindex, nofollow, noarchive
