# Relative on purpose: API calls then go through the Vite dev proxy on
# whatever origin the browser used, so the site works from a phone on the
# LAN as well as from localhost. An absolute http://localhost:5000 URL
# would resolve to the phone itself. Production sets the real absolute
# API URL in the Netlify dashboard, which overrides this.
VITE_API_URL=/api/website
